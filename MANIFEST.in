# Source distribution (sdist) contents for Siftelo.
# The wheel is defined by [tool.setuptools.packages.find] in pyproject.toml; the licence file is
# added to both by license-files in pyproject.toml.
#
# Included: the licence, package sources, the full test suite including tests/helpers.py,
# the synthetic demo examples, and the beta documentation.
# Excluded by default: evidence/, evaluation/, historical ZIPs, the root handoff.md,
# development reports, beta/proposed-ci/, and all caches.

include LICENSE
include NOTICE
include SECURITY.md
include CONTRIBUTING.md
include README.md
include beta/*.md
graft src
graft tests
graft examples

global-exclude __pycache__ *.py[cod]
prune evidence
prune evaluation
prune build
prune dist
prune beta/proposed-ci
